source_hpp %{

#include "gc/shared/gc_globals.hpp"
#include "gc/redlet/c2/redletBarrierSetC2.hpp"
#include "gc/redlet/redletBarrierSetAssembler.hpp"

%}

source %{

#include "gc/redlet/redletBarrierSet.hpp"
#include "gc/redlet/redletBarrierSetAssembler.hpp"

%}

// ============================================================================
// Redlet Store Instructions on PPC64
// ============================================================================

instruct redletStoreP(indirect mem, iRegPsrc src, flagsRegCR0 cr0)
%{
  predicate(UseRedletGC);
  match(Set mem (StoreP mem src));
  effect(KILL cr0);
  ins_cost(MEMORY_REF_COST);
  format %{ "std    $mem, $src\t# redlet ptr" %}
  ins_encode %{
    __ std($src$$Register, 0, $mem$$Register);
  %}
  ins_pipe(pipe_class_default);
%}

instruct redletStoreN(indirect mem, iRegNsrc src, flagsRegCR0 cr0)
%{
  predicate(UseRedletGC);
  match(Set mem (StoreN mem src));
  effect(KILL cr0);
  ins_cost(MEMORY_REF_COST);
  format %{ "stw    $mem, $src\t# redlet narrow ptr" %}
  ins_encode %{
    __ stw($src$$Register, 0, $mem$$Register);
  %}
  ins_pipe(pipe_class_default);
%}

// ============================================================================
// Redlet CompareAndSwap (CAS) Instructions on PPC64
// ============================================================================

instruct redletCompareAndSwapP(iRegIdst res, indirect mem, iRegPsrc oldval, iRegPsrc newval, flagsRegCR0 cr0)
%{
  predicate(UseRedletGC);
  match(Set res (CompareAndSwapP mem (Binary oldval newval)));
  match(Set res (WeakCompareAndSwapP mem (Binary oldval newval)));
  effect(TEMP_DEF res, KILL cr0);
  format %{ "CMPXCHGD $res, $mem, $oldval, $newval; as bool; ptr" %}
  ins_encode %{
    Label no_update;
    __ li($res$$Register, 0);
    __ cmpxchgd(CR0, R0, $oldval$$Register, $newval$$Register, $mem$$Register,
                MacroAssembler::MemBarNone, MacroAssembler::cmpxchgx_hint_atomic_update(),
                noreg, &no_update, true);
    __ li($res$$Register, 1);
    __ bind(no_update);
  %}
  ins_pipe(pipe_class_default);
%}

instruct redletCompareAndSwapN(iRegIdst res, indirect mem, iRegNsrc oldval, iRegNsrc newval, flagsRegCR0 cr0)
%{
  predicate(UseRedletGC);
  match(Set res (CompareAndSwapN mem (Binary oldval newval)));
  match(Set res (WeakCompareAndSwapN mem (Binary oldval newval)));
  effect(TEMP_DEF res, KILL cr0);
  format %{ "CMPXCHGW $res, $mem, $oldval, $newval; as bool; ptr" %}
  ins_encode %{
    Label no_update;
    __ li($res$$Register, 0);
    __ cmpxchgw(CR0, R0, $oldval$$Register, $newval$$Register, $mem$$Register,
                MacroAssembler::MemBarNone, MacroAssembler::cmpxchgx_hint_atomic_update(),
                noreg, &no_update, true);
    __ li($res$$Register, 1);
    __ bind(no_update);
  %}
  ins_pipe(pipe_class_default);
%}

// ============================================================================
// Redlet CompareAndExchange (CAE) Instructions on PPC64
// ============================================================================

instruct redletCompareAndExchangeP(iRegPdst res, indirect mem, iRegPsrc oldval, iRegPsrc newval, flagsRegCR0 cr0)
%{
  predicate(UseRedletGC);
  match(Set res (CompareAndExchangeP mem (Binary oldval newval)));
  effect(TEMP_DEF res, KILL cr0);
  format %{ "CMPXCHGD $res, $mem, $oldval, $newval; as ptr; ptr" %}
  ins_encode %{
    Label no_update;
    __ cmpxchgd(CR0, $res$$Register, $oldval$$Register, $newval$$Register, $mem$$Register,
                MacroAssembler::MemBarNone, MacroAssembler::cmpxchgx_hint_atomic_update(),
                noreg, &no_update, true);
    __ bind(no_update);
  %}
  ins_pipe(pipe_class_default);
%}

instruct redletCompareAndExchangeN(iRegNdst res, indirect mem, iRegNsrc oldval, iRegNsrc newval, flagsRegCR0 cr0)
%{
  predicate(UseRedletGC);
  match(Set res (CompareAndExchangeN mem (Binary oldval newval)));
  effect(TEMP_DEF res, KILL cr0);
  format %{ "CMPXCHGW $res, $mem, $oldval, $newval; as narrow ptr; ptr" %}
  ins_encode %{
    Label no_update;
    __ cmpxchgw(CR0, $res$$Register, $oldval$$Register, $newval$$Register, $mem$$Register,
                MacroAssembler::MemBarNone, MacroAssembler::cmpxchgx_hint_atomic_update(),
                noreg, &no_update, true);
    __ bind(no_update);
  %}
  ins_pipe(pipe_class_default);
%}

// ============================================================================
// Redlet Atomic Exchange (GetAndSet) Instructions on PPC64
// ============================================================================

instruct redletGetAndSetP(iRegPdst res, indirect mem, iRegPsrc newval, flagsRegCR0 cr0)
%{
  predicate(UseRedletGC);
  match(Set res (GetAndSetP mem newval));
  effect(TEMP_DEF res, KILL cr0);
  format %{ "xchgd   $res, $newval, $mem" %}
  ins_encode %{
    Label retry;
    __ bind(retry);
    __ ldarx($res$$Register, $mem$$Register);
    __ stdcx_($newval$$Register, 0, $mem$$Register);
    __ bne(CR0, retry);
  %}
  ins_pipe(pipe_class_default);
%}

instruct redletGetAndSetN(iRegNdst res, indirect mem, iRegNsrc newval, flagsRegCR0 cr0)
%{
  predicate(UseRedletGC);
  match(Set res (GetAndSetN mem newval));
  effect(TEMP_DEF res, KILL cr0);
  format %{ "xchgw   $res, $newval, $mem" %}
  ins_encode %{
    Label retry;
    __ bind(retry);
    __ lwarx($res$$Register, $mem$$Register);
    __ stwcx_($newval$$Register, 0, $mem$$Register);
    __ bne(CR0, retry);
  %}
  ins_pipe(pipe_class_default);
%}
