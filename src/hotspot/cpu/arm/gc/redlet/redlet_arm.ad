source_hpp %{

#include "gc/shared/gc_globals.hpp"
#include "gc/redlet/c2/redletBarrierSetC2.hpp"
#include "gc/redlet/redletBarrierSetAssembler.hpp"

%}

source %{

#include "gc/redlet/redletBarrierSet.hpp"
#include "gc/redlet/redletBarrierSetAssembler.hpp"

%}

// ============================================================================
// Redlet Store Instructions on ARM (32-bit)
// ============================================================================

instruct redletStoreP(memoryP mem, store_ptr_RegP src)
%{
  predicate(UseRedletGC);
  match(Set mem (StoreP mem src));
  ins_cost(MEMORY_REF_COST);
  size(4);
  format %{ "STR    $src,$mem\t# redlet ptr" %}
  ins_encode %{
    __ str($src$$Register, $mem$$Address);
  %}
  ins_pipe(istore_mem_spORreg);
%}

// ============================================================================
// Redlet Load Instructions on ARM (32-bit)
// ============================================================================

instruct redletLoadP(iRegP dst, memoryP mem)
%{
  predicate(UseRedletGC);
  match(Set dst (LoadP mem));
  ins_cost(MEMORY_REF_COST);
  size(4);
  format %{ "LDR    $dst,$mem\t# redlet ptr" %}
  ins_encode %{
    __ ldr($dst$$Register, $mem$$Address);
  %}
  ins_pipe(iload_mem);
%}

// ============================================================================
// Redlet CompareAndSwap Instructions on ARM (32-bit)
// ============================================================================

instruct redletCompareAndSwapP(memoryex mem, iRegP oldval, iRegP newval, iRegI res, iRegI tmp, flagsReg ccr)
%{
  predicate(UseRedletGC);
  match(Set res (CompareAndSwapP mem (Binary oldval newval)));
  effect(KILL ccr, TEMP tmp);
  size(28);
  format %{ "loop: \n\t"
            "LDREX    $tmp, $mem\t# redlet CAS\n\t"
            "CMP      $tmp, $oldval\n\t"
            "STREX.eq $tmp, $newval, $mem\n\t"
            "MOV.ne   $tmp, 0 \n\t"
            "EORS.eq  $tmp,$tmp, 1 \n\t"
            "B.eq     loop \n\t"
            "MOV      $res, $tmp" %}
  ins_encode %{
    Label loop;
    __ bind(loop);
    __ ldrex($tmp$$Register, $mem$$Address);
    __ cmp($tmp$$Register, $oldval$$Register);
    __ strex($tmp$$Register, $newval$$Register, $mem$$Address, eq);
    __ mov($tmp$$Register, 0, ne);
    __ eors($tmp$$Register, $tmp$$Register, 1, eq);
    __ b(loop, eq);
    __ mov($res$$Register, $tmp$$Register);
  %}
  ins_pipe(long_memory_op);
%}

// ============================================================================
// Redlet GetAndSet Instructions on ARM (32-bit)
// ============================================================================

instruct redletGetAndSetP(memoryex mem, iRegP newval, iRegP res, iRegI tmp, flagsReg ccr)
%{
  predicate(UseRedletGC);
  match(Set res (GetAndSetP mem newval));
  effect(KILL ccr, TEMP tmp, TEMP res);
  size(16);
  format %{ "loop: \n\t"
            "LDREX    $res, $mem\t# redlet xchg\n\t"
            "STREX    $tmp, $newval, $mem\n\t"
            "CMP      $tmp, 0 \n\t"
            "B.ne     loop \n\t" %}
  ins_encode %{
    Label loop;
    __ bind(loop);
    __ ldrex($res$$Register, $mem$$Address);
    __ strex($tmp$$Register, $newval$$Register, $mem$$Address);
    __ cmp($tmp$$Register, 0);
    __ b(loop, ne);
  %}
  ins_pipe(long_memory_op);
%}
