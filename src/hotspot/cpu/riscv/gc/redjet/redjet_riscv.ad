source_hpp %{

#include "gc/shared/gc_globals.hpp"
#include "gc/redjet/runtime/redjetBarrierSetC2.hpp"
#include "gc/redjet/runtime/redjetSupport.hpp"
#include "gc/redjet/runtime/redjetBarrierSetAssembler.hpp"
#include "gc/redjet/engine/redjetPointCoordinator.hpp"

void redjet_riscv_emit_pausepoint_poll(MacroAssembler* masm, Register scratch);
void redjet_riscv_emit_safepoint_poll(MacroAssembler* masm, Register scratch);

%}

source %{

#include "gc/redjet/runtime/redjetBarrierSet.hpp"
#include "gc/redjet/runtime/redjetBarrierSetAssembler.hpp"

void redjet_riscv_emit_pausepoint_poll(MacroAssembler* masm, Register scratch) {
  Label done;
  masm->la(scratch, ExternalAddress((address)RedjetPointCoordinator::pausepoint_gate_address()));
  masm->lw(scratch, Address(scratch));
  masm->beqz(scratch, done);
  masm->push_call_clobbered_registers(true);
  masm->mv(c_rarg1, zr);
  masm->super_call_VM_leaf(CAST_FROM_FN_PTR(address, redjet_rt_pausepoint_poll_slow), xthread, c_rarg1);
  masm->pop_call_clobbered_registers(true);
  masm->bind(done);
}

void redjet_riscv_emit_safepoint_poll(MacroAssembler* masm, Register scratch) {
  Label done;
  masm->la(scratch, ExternalAddress((address)RedjetPointCoordinator::safepoint_flag_address()));
  masm->lw(scratch, Address(scratch));
  masm->beqz(scratch, done);
  masm->push_call_clobbered_registers(true);
  masm->super_call_VM_leaf(CAST_FROM_FN_PTR(address, redjet_rt_safepoint_poll_slow), xthread);
  masm->pop_call_clobbered_registers(true);
  masm->bind(done);
}

%}

// ============================================================================
// Redjet Store Instructions on RISC-V (RV64)
// ============================================================================

instruct redjetStoreP(indirectP mem, iRegP src)
%{
  predicate(UseRedjetGC);
  match(Set mem (StoreP mem src));
  ins_cost(MEMORY_REF_COST);
  size(4);
  format %{ "sd $src, $mem\t# redjet ptr" %}
  ins_encode %{
    __ sd($src$$Register, $mem$$Address);
  %}
  ins_pipe(memory);
%}

// ============================================================================
// Redjet Load Instructions on RISC-V (RV64)
// ============================================================================

instruct redjetLoadP(iRegP dst, indirectP mem)
%{
  predicate(UseRedjetGC);
  match(Set dst (LoadP mem));
  ins_cost(MEMORY_REF_COST);
  size(4);
  format %{ "ld $dst, $mem\t# redjet ptr" %}
  ins_encode %{
    __ ld($dst$$Register, $mem$$Address);
  %}
  ins_pipe(pipe_class_default);
%}
